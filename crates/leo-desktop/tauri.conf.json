{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leo",
  "mainBinaryName": "leo-app",
  "identifier": "io.github.chewton2k.leo",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Notes, recordings and dictation",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1QTZFMzU1QUQwNEZDMjEKUldRaC9BU3RWZU9tSlI3MW5ObGVvSUIyQ2NtbllWdzB4QzQ0bVJNbjM1aUtGblEwa2x6RFI1TUIK",
      "endpoints": [
        "https://github.com/chewton2k/leo-cli/releases/latest/download/latest.json"
      ]
    }
  }
}
