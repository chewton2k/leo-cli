{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What leo's own window may ask of the app",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
